{
    "name": "porta/image-viewer",
    "description": "Shows images and SVGs in an editor pane, as half-block cells",
    "type": "porta-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-gd": "*",
        "symfony/process": "^8.2",
        "symfony/tui": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Porta\\ImageViewer\\": "src/"
        }
    },
    "extra": {
        "porta": {
            "tools": [
                {
                    "name": "rsvg-convert",
                    "role": "suggested",
                    "purpose": "shows SVG files as images",
                    "setting": "svgConverter",
                    "sources": [
                        [
                            "brew",
                            "librsvg"
                        ]
                    ]
                }
            ]
        }
    }
}
